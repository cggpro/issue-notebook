# 可选的 AI 可视化配置。复制为 .env，填写后重启后端。
# 已存在的进程环境变量优先。不要提交真实密钥。
# 请取消下面三项的注释，并替换为服务商提供的模型、地址和密钥。
# VISUALIZATION_MODEL=your-model-name
# VISUALIZATION_BASE_URL=https://api.example.com/v1
# VISUALIZATION_API_KEY=your-key

# 智谱配置（与上方通用接口配置二选一）：
# ZHIPU_MODEL=glm-5.3-flash
# ZHIPU_API_KEY=your-key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Coding Plan Key 配套地址：
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# 未显式配置 Key 时，可回退到本机 Pi 的 zai-coding-cn 配置。

# 可选的工作台访问与存储配置：
# HOST=0.0.0.0
# PORT=3001
# DATA_DIR=./data
# API_KEY=your-workspace-access-key
