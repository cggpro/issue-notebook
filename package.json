{
  "name": "issue-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "轻量的 Markdown 问题工作台",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.8",
    "@vitejs/plugin-react": "^4.4.0",
    "diff": "^8.0.0",
    "fastify": "^5.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
